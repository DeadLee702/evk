# Copy to .env and fill in real values. Do NOT commit .env with secrets.
# Paths
Z12_KILL_LOG=/var/log/z12/kill.log
# Enforcement mode:
#  - STUB (default): logs enforcement actions but does not call kill(2)
#  - ENFORCE: performs real enforcement (kill(2)). Only set on dedicated hosts.
KILL_MODE=STUB
# Key management (do NOT put private keys in repo)
GEMINI_KEY_PATH=$HOME/.z12/keystore/gemini_ed25519     # private key file
GEMINI_PUB_PATH=$HOME/.z12/keystore/gemini_ed25519.pub
# Optional: path override for sibling repos in demo
Z12_GEMINI_PATH=../gemini-box
Z12_ACM_PATH=../adversarial-compliance-matrix
# CI/Release - leave unset locally
DOCKER_REGISTRY=ghcr.io
DOCKER_NAMESPACE=your-org-or-user
